"""Static types for the Grail API.

The runtime facade picks its implementation dynamically, which checkers cannot
follow, so this stub states the public API for both implementations.
"""

import abc
import builtins
import sys
from collections.abc import Callable, Iterable, Iterator, Mapping, Sequence, Set
from types import TracebackType
from typing import (Any, Final, Generic as _TypingGeneric, Literal, NamedTuple,
                    ParamSpec, Protocol, TypeVar, overload)

from typing_extensions import Self, dataclass_transform

_T = TypeVar("_T")
_T_co = TypeVar("_T_co", covariant=True)
_K = TypeVar("_K")
_V = TypeVar("_V")
_R = TypeVar("_R")
_R_co = TypeVar("_R_co", covariant=True)
_A = TypeVar("_A")
_P = ParamSpec("_P")
_F = TypeVar("_F", bound=Callable[..., Any])

backend: Final[str]
pds_backend: Final[str]


class _Missing: ...


MISSING: Final[_Missing]


class FieldInfo(NamedTuple):
    name: str
    annotation: Any
    kind: Literal["value", "ordinary"]
    default: Any
    factory: Any


@overload
def field(*, default: _T) -> _T: ...
@overload
def field(*, factory: Callable[[], _T]) -> _T: ...


@overload
@dataclass_transform(field_specifiers=(field,), frozen_default=True)
def record(cls: type[_T], /) -> type[_T]: ...
@overload
@dataclass_transform(field_specifiers=(field,), frozen_default=True)
def record(*, deriving: Iterable[str] = ()) -> Callable[[type[_T]], type[_T]]: ...


if sys.version_info >= (3, 13):
    class _SupportsReplace(Protocol[_P, _R_co]):
        """Checkers synthesize __replace__ for dataclass_transform classes, so
        the keyword arguments of replace() are tied to the type of the record."""
        def __replace__(self, *args: _P.args, **kwargs: _P.kwargs) -> _R_co: ...

    def replace(obj: _SupportsReplace[_P, _R], /, *args: _P.args, **kwargs: _P.kwargs) -> _R: ...
else:
    # mypy synthesizes __replace__ only when targeting 3.13+.
    def replace(obj: _T, /, **changes: Any) -> _T: ...


def record_fields(record_type: type, /) -> tuple[FieldInfo, ...]: ...
def record_values(obj: object, /) -> dict[str, Any]: ...
def is_record(obj: object, /) -> bool: ...
def is_value_record(record_type: type, /) -> bool: ...
def conforms(obj: object, /) -> bool: ...
def substitutable(a: object, b: object, /) -> bool: ...


class Record(abc.ABC):
    """Every record type is a virtual subclass: a dispatch key for any record."""


class Generic(_TypingGeneric[_P, _R_co]):
    """Calls have the fallback's signature. Implementations are loosely typed,
    since each one narrows the dispatch parameter."""
    @property
    def fallback(self) -> Callable[_P, _R_co]: ...
    @property
    def version(self) -> int: ...
    @property
    def pair(self) -> bool: ...
    @property
    def __name__(self) -> str: ...
    def __call__(self, *args: _P.args, **kwargs: _P.kwargs) -> _R_co: ...
    def register(self, dispatch: Any, func: _F, override: bool = False) -> _F: ...
    def dispatch(self, dispatch: Any, /) -> Callable[..., Any]: ...
    def impl(self, func: _F, /) -> _F: ...
    @overload
    def override(self, func: _F, /) -> _F: ...
    @overload
    def override(self, dispatch: Any, func: _F, /) -> _F: ...


def generic(fallback: Callable[_P, _R], /) -> Generic[_P, _R]: ...


class _Binary(Protocol):
    @property
    def version(self) -> int: ...
    def __call__(self, a: Any, b: Any, /) -> Any: ...
    def register(self, dispatch: tuple[Any, Any], func: _F, override: bool = False) -> _F: ...
    def dispatch(self, dispatch: tuple[Any, Any], /) -> Callable[..., Any]: ...
    def impl(self, func: _F, /) -> _F: ...
    def override(self, *args: Any) -> Any: ...


class _Ops(NamedTuple):
    add: _Binary
    sub: _Binary
    mul: _Binary
    truediv: _Binary
    neg: Generic[[Any], Any]
    abs: Generic[[Any], Any]


ops: Final[_Ops]
repr: Final[Generic[[Any], builtins.str]]
eq: Final[Generic[[Any, Any], bool]]
hash: Final[Generic[[Any], int]]


class Atom(_TypingGeneric[_T]):
    def __new__(cls, value: _T) -> Atom[_T]: ...
    @property
    def value(self) -> _T: ...
    def reset(self, value: _T, /) -> _T: ...
    def compare_and_set(self, expected: _T, desired: _T, /) -> bool: ...
    def swap(self, f: Callable[..., _T], /, *args: Any, **kwargs: Any) -> _T: ...
    def add(self, delta: int, /) -> int: ...


class PMap(Mapping[_K, _V]):
    @overload
    def __new__(cls) -> PMap[_K, _V]: ...
    @overload
    def __new__(cls, source: Mapping[_K, _V] | Iterable[tuple[_K, _V]], /) -> PMap[_K, _V]: ...
    def __getitem__(self, key: _K, /) -> _V: ...
    def __iter__(self) -> Iterator[_K]: ...
    def __len__(self) -> int: ...
    def set(self, key: _K, value: _V, /) -> PMap[_K, _V]: ...
    def delete(self, key: _K, /) -> PMap[_K, _V]: ...
    def update_with(self, other: Mapping[_K, _V], fn: Callable[[_V, _V], _V], /) -> PMap[_K, _V]: ...
    def mutate(self) -> Any: ...
    def __or__(self, other: Mapping[_K, _V], /) -> PMap[_K, _V]: ...


class PSet(Set[_T_co]):
    @overload
    def __new__(cls) -> PSet[_T_co]: ...
    @overload
    def __new__(cls, source: Iterable[_T_co], /) -> PSet[_T_co]: ...
    def __contains__(self, x: object, /) -> bool: ...
    def __iter__(self) -> Iterator[_T_co]: ...
    def __len__(self) -> int: ...
    def add(self, x: Any, /) -> PSet[Any]: ...
    def discard(self, x: Any, /) -> PSet[_T_co]: ...
    def mutate(self) -> Any: ...


class PVector(Sequence[_T_co]):
    @overload
    def __new__(cls) -> PVector[_T_co]: ...
    @overload
    def __new__(cls, source: Iterable[_T_co], /) -> PVector[_T_co]: ...
    @overload
    def __getitem__(self, key: int, /) -> _T_co: ...
    @overload
    def __getitem__(self, key: slice, /) -> PVector[_T_co]: ...
    def __len__(self) -> int: ...
    def set(self, index: int, value: Any, /) -> PVector[Any]: ...
    def append(self, value: Any, /) -> PVector[Any]: ...
    def pop(self) -> PVector[_T_co]: ...
    def mutate(self) -> Any: ...
    def __add__(self, other: Iterable[Any], /) -> PVector[Any]: ...


class _NumVector(Sequence[_T]):
    def __new__(cls, source: Iterable[_T] = ..., /) -> Self: ...
    @overload
    def __getitem__(self, key: int, /) -> _T: ...
    @overload
    def __getitem__(self, key: slice, /) -> Self: ...
    def __len__(self) -> int: ...
    def tolist(self) -> list[_T]: ...
    def set(self, index: int, value: _T, /) -> Self: ...
    def append(self, value: _T, /) -> Self: ...
    def pop(self) -> Self: ...
    def mutate(self) -> Any: ...
    def __add__(self, other: Iterable[_T], /) -> Self: ...


class FloatVector(_NumVector[float]): ...
class IntVector(_NumVector[int]): ...


class _Draft(_TypingGeneric[_T]):
    """A draft's edits are not checked: its fields mirror the frozen value's
    with their types widened to allow assignment, which typing cannot express."""
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...
    def __getitem__(self, key: Any, /) -> Any: ...
    def __setitem__(self, key: Any, value: Any, /) -> None: ...
    def __delitem__(self, key: Any, /) -> None: ...
    def __len__(self) -> int: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None, /) -> bool | None: ...


def mutate(value: _T, /) -> _Draft[_T]: ...
def finish(draft: _Draft[_T], /) -> _T: ...
def original(draft: _Draft[_T], /) -> _T: ...


class PoolMapResults(Iterator[_T]):
    def __next__(self) -> _T: ...


class Scope:
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None, /) -> bool | None: ...
    def spawn(self, func: Callable[..., Any], /, *args: Any, **kwargs: Any) -> None: ...


class Pool:
    def __new__(cls, n_threads: int) -> Pool: ...
    @property
    def n_threads(self) -> int: ...
    def map(self, func: Callable[..., _R], /, *iterables: Iterable[Any],
            buffersize: int | None = None, return_in_order: bool = True) -> PoolMapResults[_R]: ...
    def scope(self) -> Scope: ...
    def shutdown(self, wait: bool = True) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None, /) -> bool | None: ...


def pool() -> Pool: ...
def pmap(func: Callable[[_T], _R], iterable: Iterable[_T], /, *,
         chunk: int | None = None, pool: Pool | None = None) -> list[_R]: ...
def parallel_reduce(fold: Callable[[_A, _T], _A], combine: Callable[[_A, _A], _A],
                    iterable: Iterable[_T], init: _A, *,
                    chunk: int | None = None, pool: Pool | None = None) -> _A: ...
